# ── HeroesProfile ────────────────────────────────────────
# Register at heroesprofile.com/Api, verify, subscribe (Basic or
# Intermediate), and generate a token from your account page. Never commit
# the real value — this file is the template, .env (gitignored) holds it.
HEROESPROFILE_API_TOKEN=

# Rank/MMR bracket used to filter hero stats, talent builds, and matchups.
# Must match one of HeroesProfile's tier labels (e.g. Bronze, Silver, Gold,
# Platinum, Diamond, Master, Grandmaster). Set this to Clay's current bracket
# and update it as it changes season to season.
HEROESPROFILE_RANK_TIER=Diamond

# Override only if HeroesProfile's base URL or your tier's path prefix
# differs from the default — see heroesprofile_client.py's module docstring.
HEROESPROFILE_BASE_URL=https://api.heroesprofile.com/api

# Minimum seconds between outbound HeroesProfile requests. Conservative
# default — tighten once you've read your tier's documented rate limit.
HEROESPROFILE_MIN_INTERVAL=1.0

# ── Polling schedule (minutes) ────────────────────────────
# Personal + roster match history. HeroesProfile's own data lags Blizzard's
# replay processing by 15-30+ minutes, so polling much faster than that just
# burns API calls without finding anything new.
MATCH_POLL_MINUTES=20

# Hero/talent/matchup rank-wide stat caches. These move slowly — a long
# interval is kinder to the rate limit.
STATS_POLL_MINUTES=360

# ── App ──────────────────────────────────────────────────
PORT=3001
